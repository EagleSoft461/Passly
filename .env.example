# =============================================================================
# Passly — Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in your own values before starting the app.
#
#   cp .env.example .env
#
# The .env file is git-ignored and must never be committed.
# =============================================================================


# --- PostgreSQL ---
# Credentials for the local PostgreSQL instance.
# The same values are consumed by both docker-compose (to create the database)
# and the auth-server (to connect to it). They must match.
POSTGRES_DB=passly
POSTGRES_USER=passly
POSTGRES_PASSWORD=change-me-use-a-strong-password


# --- Redis ---
# Host and port of the local Redis instance.
# REDIS_HOST should be "redis" when running inside Docker Compose,
# or "localhost" when running the auth-server from the IDE.
REDIS_HOST=localhost
REDIS_PORT=6379


# --- Google OAuth ---
# Obtain these from Google Cloud Console → APIs & Services → Credentials.
# Create an "OAuth 2.0 Client ID" of type "Web application".
#
# Required Authorized Redirect URI to register in Google Cloud Console:
#   http://localhost:9000/login/oauth2/code/google
#
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# The redirect URI that Passly registers with Google during the OAuth flow.
# Must exactly match one of the Authorized Redirect URIs configured in
# Google Cloud Console for your OAuth client.
# Default (no change needed for local development):
GOOGLE_REDIRECT_URI=http://localhost:9000/login/oauth2/code/google
